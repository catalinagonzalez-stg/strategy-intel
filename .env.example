# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — classification + newsletter generation (gpt-4o)
OPENAI_API_KEY=

# Serper (google.serper.dev) — Google News search for sources without RSS.
# Prepaid credits: if the balance hits zero every serper source returns HTTP 400
# and the ingest logs the error per source. Recharge at https://serper.dev
SERPER_API_KEY=

# Slack — newsletter posting
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Cron auth (Bearer token for /api/cron/* endpoints)
CRON_SECRET=

# Base URL the full-pipeline uses to call its own endpoints
NEXT_PUBLIC_SITE_URL=https://strategy-intel.onrender.com
