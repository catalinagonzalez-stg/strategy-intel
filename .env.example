# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — classification + newsletter generation (gpt-4o)
OPENAI_API_KEY=

# 'serper'-type sources search Google News via its free RSS endpoint
# (news.google.com/rss/search) — no API key needed. The name is historical:
# they used the paid Serper API until ago-2026.

# Slack — newsletter posting
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Cron auth (Bearer token for /api/cron/* endpoints)
CRON_SECRET=

# Base URL the full-pipeline uses to call its own endpoints
NEXT_PUBLIC_SITE_URL=https://strategy-intel.onrender.com
